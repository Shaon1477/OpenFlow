{
  "name": "openflow-engine",
  "version": "0.2.0",
  "description": "Governed AI delivery CLI: stages, human gates, project rules, drift",
  "type": "module",
  "bin": {
    "openflow": "./bin/openflow"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "built-in-flows",
    "workflow-rules",
    "schemas",
    "templates",
    "openflow-rules",
    "openflow-rule-details",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "ATTRIBUTION.md"
  ],
  "license": "MIT",
  "keywords": [
    "openflow",
    "cli",
    "ai",
    "workflow",
    "cursor"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
