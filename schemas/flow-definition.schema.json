{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openflow.dev/schemas/flow-definition.schema.json",
  "title": "OpenFlow Flow Definition",
  "type": "object",
  "required": ["id", "name", "steps"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "roles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Roles this flow involves; must exist in openflow.yml repos"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["key", "name"],
      "additionalProperties": true,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Stable stage id used by state, gates and the CLI"
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "analyze",
            "plan",
            "implement",
            "test-cases",
            "integrate",
            "test-automation",
            "handoff",
            "sync-context",
            "custom"
          ],
          "default": "custom"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Repo role this stage acts on; drives rule packs and sub-item lookup"
        },
        "repos": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Roles whose repos this stage may write to"
        },
        "human_gate": { "type": "boolean", "default": true },
        "optional": { "type": "boolean", "default": false },
        "note": { "type": "string" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Upstream stage keys; drives drift propagation"
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Engine rule files relative to the rule-details root"
        },
        "use": {
          "type": "string",
          "minLength": 1,
          "description": "Load per-step playbook from workflow-rules/<use>/<key>.md instead of this flow's folder (e.g. default)"
        },
        "rule_packs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Roles whose project rule packs load; defaults to [role]"
        },
        "skills": { "type": "array", "items": { "type": "string" } },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path templates tracked for drift; supports {repo}, {repo:<role>}, {ticket}, {sub_ticket}, {artifacts_dir}"
        },
        "detail_file": {
          "type": "string",
          "description": "Stage protocol override, required for kind: custom"
        },
        "verify": {
          "type": "boolean",
          "default": false,
          "description": "Require completeness/correctness/coherence check before the gate"
        }
      }
    }
  }
}
