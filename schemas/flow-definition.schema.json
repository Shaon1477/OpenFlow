{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openflow.dev/schemas/flow-definition.schema.json",
  "title": "OpenFlow Definition",
  "type": "object",
  "required": ["id", "name", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "repos": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["id", "name", "detail_file", "repos", "human_gate", "skills", "rules"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "name": { "type": "string", "minLength": 1 },
        "detail_file": { "type": "string", "minLength": 1 },
        "repos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "human_gate": { "type": "boolean" },
        "optional": { "type": "boolean", "default": false },
        "note": { "type": "string" },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
